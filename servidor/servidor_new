 location ^~ /onlyoffice/ {
        
        alias /var/React/onlyoffice/frontend/dist/;
        index index.html;
    
        # Permitir que React maneje el enrutamiento
        try_files $uri /onlyoffice/index.html;
    }
 
 location /onlyoffice/api/ {
    proxy_pass http://localhost:3000;
   proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;

        # Configurar encabezados CORS para permitir el acceso desde el frontend
        add_header Access-Control-Allow-Origin *;
        add_header Access-Control-Allow-Methods 'GET, POST, PUT, DELETE, OPTIONS';
        add_header Access-Control-Allow-Headers 'Origin, X-Requested-With, Content-Type, Accept, Authorization';

        # Responder correctamente a las solicitudes OPTIONS
        if ($request_method = 'OPTIONS') {
            add_header Access-Control-Allow-Origin *;
            add_header Access-Control-Allow-Methods 'GET, POST, PUT, DELETE, OPTIONS';
            add_header Access-Control-Allow-Headers 'Origin, X-Requested-With, Content-Type, Accept, Authorization';
            add_header Content-Type 'text/plain charset=UTF-8';
            add_header Content-Length 0;
            return 204;
        }
}
        location = /404.html {
        root /var/www/html;
        internal;
    }
    location /databuengobierno {
        alias /var/React/Data/front-data-buengobierno/build;
        index index.html;
    
        # Permitir que React maneje el enrutamiento
        try_files $uri /databuengobierno/index.html;
    }

location /libretranslate/ {

    rewrite ^/libretranslate(/.*)$ $1 break;

    proxy_pass http://127.0.0.1:5500;

    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    add_header Access-Control-Allow-Origin *;
    add_header Access-Control-Allow-Methods 'GET, POST, OPTIONS';
    add_header Access-Control-Allow-Headers 'Origin, Content-Type, Accept, Authorization';

    if ($request_method = 'OPTIONS') {
        return 204;
    }

    proxy_connect_timeout 300;
    proxy_send_timeout 300;
    proxy_read_timeout 300;

    client_max_body_size 50M;
}
