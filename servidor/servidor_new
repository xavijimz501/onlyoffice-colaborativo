server {
    listen 80;
    server_name 172.25.30.64;
    client_max_body_size 100M;

     # Frontend principal
    root /var/React/Data/front-data-buengobierno/build;
    index index.html;

    location /favicon.ico {
        try_files $uri =404;
    }
    location ~ ^/[0-9]+\.[0-9]+\.[^/]+/ {

    proxy_pass http://127.0.0.1:8088;

    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;

    proxy_set_header X-Forwarded-For
        $proxy_add_x_forwarded_for;

    proxy_set_header X-Forwarded-Proto
        https;

    proxy_set_header X-Forwarded-Host
        $host;

    proxy_read_timeout 3600;
}


location = /onlyoffice {
    return 301 /onlyoffice/;
}

location ^~ /onlyoffice/docs/ {
    proxy_pass http://127.0.0.1:8088/;
    proxy_http_version 1.1;

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $http_host/onlyoffice/docs;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;

    proxy_read_timeout 3600;
    proxy_connect_timeout 3600;
    proxy_send_timeout 3600;
}
location /web-apps/ {

    proxy_pass http://127.0.0.1:8088/web-apps/;

    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;

    proxy_set_header X-Forwarded-For
        $proxy_add_x_forwarded_for;

    proxy_set_header X-Forwarded-Proto
        https;

    proxy_read_timeout 3600;
}


location /sdkjs/ {

