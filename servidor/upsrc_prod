    server_name upsrc.buengobierno.gob.mx;
    server_tokens off;
    set $csp_nonce $request_id;
    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options nosniff;
    add_header X-XSS-Protection "1; mode=block";
    add_header Content-Security-Policy "default-src 'self' blob: data: https://framework-gb.cdn.gob.mx https://fonts.astatic.com www.gob.mx https://8x8.vc; style-src 'self' 'unsafe-inline' https://framework-gb.cdn.gob.mx https://fonts.astatic.com https://fonts.googleapis.com https://cdn.jsdelivr.net https://kit-pro.fontawesome.com https://translate.googleapis.com https://*.gstatic.com https://www.googletagmanager.com https://stackpath.bootstrapcdn.com https://www.juicer.io https://react-tweet.vercel.app; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://framework-gb.cdn.gob.mx https://www.google-analytics.com https://ajax.googleapis.com https://8x8.vc https://upsrc.buengobierno.gob.mx https://upsrc.buengobierno.gob.mx/onlyoffice https://cdn.jsdelivr.net https://translate.google.com https://translate.googleapis.com https://*.gstatic.com https://translate-pa.googleapis.com https://www.googletagmanager.com https://stackpath.bootstrapcdn.com https://www.google.com https://*.x.com https://*.twitter.com https://www.juicer.io https://widget.rss.app https://connect.facebook.net https://www.instagram.com; img-src 'self' data: https://framework-gb.cdn.gob.mx https://www.gob.mx https://ajax.googleapis.com https://www.google-analytics.com https://8x8.vc https://*.facebook.com https://*.cdninstagram.com https://*.instagram.com blob: https://cdn.jsdelivr.net https://translate.googleapis.com https://*.gstatic.com https://www.google.com https://translate.google.com https://www.juicer.io https://juicer.io https://pbs.twimg.com https://*.fbcdn.net https://*.cdninstagram.com https://react-tweet.vercel.app https://flagcdn.com; font-src 'self' https://framework-gb.cdn.gob.mx https://fonts.astatic.com https://fonts.gstatic.com https://kit-pro.fontawesome.com https://cdn.jsdelivr.net https://www.googletagmanager.com https://stackpath.bootstrapcdn.com data:; connect-src 'self' https://framework-gb.cdn.gob.mx https://www.google-analytics.com https://8x8.vc https://upsrc.buengobierno.gob.mx wss://upsrc.buengobierno.gob.mx https://upsrc.buengobierno.gob.mx/onlyoffice https://translate.googleapis.com https://translate.google.com https://translate-pa.googleapis.com https://www.google.com https://www.juicer.io https://corsproxy.io https://rss.app https://react-tweet.vercel.app https://cdn.jsdelivr.net; frame-src 'self' https://8x8.vc https://upsrc.buengobierno.gob.mx https://*.twitter.com https://www.juicer.io https://www.facebook.com https://*.facebook.com https://www.instagram.com https://*.instagram.com blob: data:; media-src 'self' https://8x8.vc; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' https://upsrc.buengobierno.gob.mx https://react-tweet.vercel.app; upgrade-insecure-requests;" always;
     set $nonce $request_id;


   
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always; 

    proxy_cookie_path / "/; HTTPOnly; Secure; SameSite=strict";
    add_header X-Robots-Tag "index, follow" always;

    # Configuración de tamaño para grandes archivos y tiempos de espera largos
    client_body_buffer_size 1k;
    client_header_buffer_size 1k;
    client_max_body_size 200M;  # Asegura que los archivos grandes puedan ser subidos
    large_client_header_buffers 2 1k;
    client_body_timeout 60s;
    client_header_timeout 60s;
    send_timeout 60s;

    ssl_certificate /etc/ssl/buengobierno.gob.mx/fullchain.cer;
    ssl_certificate_key /etc/ssl/buengobierno.gob.mx/buengobierno.gob.mx.key;
    
    #ssl_protocols TLSv1 TLSv1.1 TLSv1.2 TLSv1.3; # Dropping SSLv3, ref: POODLE
    ssl_prefer_server_ciphers on;
    #ssl_ciphers ALL:!aNULL:!ADH:!eNULL:!LOW:!EXP:RC4+RSA:+HIGH:+MEDIUM;
    ssl_protocols TLSv1.2 TLSv1.3; # Requires nginx >= 1.13.0 else use TLSv1.2
    ssl_ciphers ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES256-GCM-SHA384;
  
