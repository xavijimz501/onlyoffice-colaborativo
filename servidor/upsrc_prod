 location ~ ^/[0-9]+\.[0-9]+\.[^/]+/ {

    proxy_pass http://127.0.0.1:8088;

    proxy_http_version 1.1;

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;

    proxy_set_header X-Forwarded-For
        $proxy_add_x_forwarded_for;

    proxy_set_header X-Forwarded-Proto
        https;

    proxy_set_header X-Forwarded-Host
        $host;

    proxy_read_timeout 3600;
    proxy_connect_timeout 3600;
    proxy_send_timeout 3600;
}
location = /onlyoffice {
    return 301 /onlyoffice/;
}

# ONLYOFFICE Document Server: coincide con ONLYOFFICE_URL del backend.
location = /onlyoffice/docs {
    return 301 /onlyoffice/docs/;
}

location ^~ /onlyoffice/docs/ {
    proxy_pass http://127.0.0.1:8088/;
    proxy_http_version 1.1;

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $http_host/onlyoffice/docs;

    proxy_read_timeout 3600;
    proxy_connect_timeout 3600;
    proxy_send_timeout 3600;
    proxy_redirect off;
}

# API de Express y Socket.IO. Se conserva /onlyoffice al reenviar a Node.
location ^~ /onlyoffice/api/ {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;

    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    proxy_read_timeout 3600;
    proxy_connect_timeout 60;
    proxy_send_timeout 3600;
}

# Frontend React: cubre solo las rutas que no coinciden con API o Document Server.
location ^~ /onlyoffice/ {
    alias /var/React/onlyoffice/frontend/dist/;
    index index.html;
    try_files $uri $uri/ /onlyoffice/index.html;
}


