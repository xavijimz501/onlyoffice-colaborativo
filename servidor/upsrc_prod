# Archivos estáticos de Data Buen Gobierno
location ^~ /databuengobierno/static/ {
    alias /var/React/Data/front-data-buengobierno/build/static/;
}

# Aplicación React Data Buen Gobierno
location ^~ /databuengobierno/ {
    alias /var/React/Data/front-data-buengobierno/build/;
