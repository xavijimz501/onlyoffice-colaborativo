# Variables compartidas por ambos perfiles
PORT=3000
HOST=0.0.0.0
DB_NAME=mindbuengob
AUTH_DB_NAME=mindbuengob
STORAGE_DIR=./storage
DOCUMENT_TEMPLATE_PATH=./storage/documentos/demo.docx

# PERFIL LOCAL: dejar activo
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_local_mysql_user
MYSQL_PASS=your_local_mysql_password
APP_JWT_SECRET=replace-with-a-long-local-session-secret
ONLYOFFICE_JWT_SECRET=replace-local-onlyoffice-secret
APP_BASE_PATH=
APP_PUBLIC_URL=http://host.docker.internal:3000
FRONTEND_ORIGIN=http://localhost:5173
ONLYOFFICE_URL=http://localhost
ONLYOFFICE_COMMAND_URL=http://localhost/command
SOCKET_IO_PATH=/socket.io

