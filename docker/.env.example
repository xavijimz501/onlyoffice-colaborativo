# Perfil local: coincide con ONLYOFFICE_JWT_SECRET del backend/.env.
ONLYOFFICE_JWT_SECRET=replace-local-onlyoffice-secret
ONLYOFFICE_IMAGE=onlyoffice/documentserver:latest

# Perfil local: publica Document Server directamente en los puertos 80 y 443.
ONLYOFFICE_BIND_ADDRESS=0.0.0.0
ONLYOFFICE_HTTP_PORT=80
ONLYOFFICE_HTTPS_PORT=443

# Perfil productivo detrás de proxy HTTPS: comentar las 3 variables locales y
# descomentar las siguientes para que Nginx/Apache use 127.0.0.1:8080.
# ONLYOFFICE_BIND_ADDRESS=127.0.0.1
# ONLYOFFICE_HTTP_PORT=8080
# ONLYOFFICE_HTTPS_PORT=8443
# ONLYOFFICE_JWT_SECRET=SET_THE_SAME_RANDOM_SECRET_AS_BACKEND_ENV
